# --- Meta / Instagram ---
META_VERIFY_TOKEN=any-random-string-you-invent
META_APP_SECRET=instagram_app_secret_from_dashboard
IG_ACCESS_TOKEN=IGAA...long_lived_token
GRAPH_BASE=https://graph.instagram.com/v21.0

# --- Gemini (aistudio.google.com/apikey) ---
GEMINI_API_KEY=AIza...
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest

# --- Database ---
# Local: sqlite:///data/bot.db
# Supabase: postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///data/bot.db

# --- Bot behaviour ---
SYSTEM_PROMPT_PATH=prompts/system_prompt.md
DEBOUNCE_SECONDS=6
HANDOFF_PAUSE_HOURS=12
# For testing 0.02 (~1 min). Production: 20
FOLLOWUP_DELAY_HOURS=20
# Follow-up text is chosen by the client's language in app/lang.py (FOLLOWUP_TEXT is no longer used)
# Mom shared a reel/post in a chat -> bot keeps quiet there for N hours
PERSONAL_PAUSE_HOURS=72

# template_wins = if IG auto-reply answered, bot stays silent | llm_only = bot always answers
TEMPLATE_MODE=llm_only
AUTO_REPLY_WINDOW_SEC=15

# Gemini: seconds per model attempt (a failed model is skipped for a while)
GEMINI_TIMEOUT_SEC=12

# Telegram: token from @BotFather. TG_CHAT_ID = mom's chat id (several: comma-separated)
TG_BOT_TOKEN=
TG_CHAT_ID=
# Technical alerts (token, Instagram, Gemini) for Vadim
TG_ADMIN_CHAT_ID=

# Personal contacts the bot must never answer (IGSIDs from the logs, comma-separated)
IGNORE_IGSIDS=

# The IG token is extended automatically every N days (fresh token is kept in the DB)
IG_TOKEN_REFRESH_DAYS=7
